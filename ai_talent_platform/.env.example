# ============================================================
# AI 数字化人才平台 —— 环境变量模板
# 使用方式：cp .env.example .env 后按本地环境修改
# 注意：.env 不要提交到 Git（已在 .gitignore 中忽略）
# ============================================================

# ------------------------------------------------------------ 应用
APP_NAME=AI 数字化人才平台
APP_VERSION=1.0.0
# dev | test | prod
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
# 允许跨域的前端来源，多个用逗号分隔；* 表示放开（仅调试）
CORS_ORIGINS=*

# ------------------------------------------------------------ MySQL（生产默认）
# 切换 MySQL：把 DB_DRIVER 改为 mysql，并填写下面的连接信息
# 开发阶段默认 DB_DRIVER=sqlite，无需安装 MySQL 即可跑通全部公共层功能
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ai_talent_platform
DB_CHARSET=utf8mb4
SQLITE_PATH=./data/app.db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
# 是否在控制台打印 SQL（调试用，平时关闭）
DB_ECHO=false

# ------------------------------------------------------------ Redis（缓存 / 会话 / 限流）
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_DEFAULT_TTL=300

# ------------------------------------------------------------ Milvus（向量库）
MILVUS_ENABLED=false
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=

# ------------------------------------------------------------ JWT / 安全
# 生产必须换成 32 位以上的随机字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12

LOGIN_MAX_FAIL_TIMES=5
LOGIN_LOCK_MINUTES=15

# ------------------------------------------------------------ 文件存储
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.txt,.png,.jpg,.jpeg

# ------------------------------------------------------------ 日志
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_ROTATION_MB=20
LOG_BACKUP_COUNT=10

# ------------------------------------------------------------ 分页
DEFAULT_PAGE=1
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200

# ------------------------------------------------------------ AI 能力层
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

DIFY_BASE_URL=http://127.0.0.1/v1
DIFY_API_KEY=
