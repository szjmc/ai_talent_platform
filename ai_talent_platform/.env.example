# ============================================================
# 标签：[架构组] [P0]（环境变量模板，settings 的唯一配置来源）
# AI 数字化人才平台 —— 环境变量模板
# 使用方式：cp .env.example .env 后按本地环境修改
# 注意：.env 不要提交到 Git（已在 .gitignore 中忽略）
# ============================================================

# ------------------------------------------------------------ 应用
APP_NAME=AI 数字化人才平台
APP_VERSION=1.0.0
# dev | test | prod
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
# 允许跨域的前端来源，多个用逗号分隔；* 表示放开（仅调试）
# 注意：* 模式下自动关闭 allow_credentials（浏览器拒绝 *+credentials 组合）
CORS_ORIGINS=*
# 启动时 create_all 自动建表：仅 dev/test 生效；prod 恒为 False（走 Alembic）
DB_AUTO_CREATE_TABLES=true

# ------------------------------------------------------------ 限流
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LIMIT=300
RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------ MySQL（业务主数据库）
# 平台不使用 SQLite：业务主数据统一使用 MySQL 8（异步驱动 mysql+aiomysql）
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ai_talent_platform
DB_CHARSET=utf8mb4

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
# 是否在控制台打印 SQL（调试用，平时关闭）
DB_ECHO=false

# ------------------------------------------------------------ PgSQL（分析 / 时序数据库）
# 存放海量履历、测评历史、培训轨迹、行为时序与分析宽表，是 Vanna NL2SQL 的查询库
# 关闭后分析类功能自动降级为「仅统计 MySQL 数据」，不影响业务接口
PGSQL_ENABLED=true
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_USER=postgres
PGSQL_PASSWORD=postgres
PGSQL_DB=ai_talent_analytics
PGSQL_SCHEMA=public
PGSQL_POOL_SIZE=5
PGSQL_MAX_OVERFLOW=10
PGSQL_POOL_RECYCLE=1800
PGSQL_ECHO=false

# ------------------------------------------------------------ Redis（缓存 / 会话 / 限流）
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_DEFAULT_TTL=300

# ------------------------------------------------------------ Milvus（向量库）
MILVUS_ENABLED=false
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=

# ------------------------------------------------------------ JWT / 安全
# 生产必须换成 32 位以上的随机字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12

LOGIN_MAX_FAIL_TIMES=5
LOGIN_LOCK_MINUTES=15

# ------------------------------------------------------------ 文件存储
# 存储后端：local（本地磁盘，默认）/ minio（自建 MinIO）/ oss（阿里云 OSS）/ s3（通用 S3 兼容）
# 业务代码统一走 get_storage()，切换后端无需改代码
STORAGE_BACKEND=local
# 对外访问基址（CDN / 反向代理），留空则按后端规则生成
STORAGE_PUBLIC_URL=
# 预签名下载地址有效期（秒）
STORAGE_PRESIGN_EXPIRE_SECONDS=3600
STORAGE_TIMEOUT=30

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.txt,.png,.jpg,.jpeg

# MinIO（S3 协议，path-style）—— docker compose --profile storage up -d 可本地拉起
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-talent
MINIO_REGION=us-east-1
# 公共读 / CDN 域名（可选），例如 https://files.example.com
MINIO_PUBLIC_URL=

# 阿里云 OSS（Signature V1）
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_SECURE=true
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_PUBLIC_URL=

# 通用 S3 兼容存储（AWS S3 / 其他网关；用 MinIO 请直接配置 MINIO_*）
S3_ENDPOINT=
S3_SECURE=true
S3_PATH_STYLE=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_PUBLIC_URL=

# ------------------------------------------------------------ 日志
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_ROTATION_MB=20
LOG_BACKUP_COUNT=10

# ------------------------------------------------------------ 分页
DEFAULT_PAGE=1
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200

# ------------------------------------------------------------ AI 能力层
# 供应商：qwen / openai / deepseek / ollama（也可自定义注册，名称即注册键）
LLM_PROVIDER=qwen
# 默认模型（留空使用供应商默认模型；与供应商不匹配的旧模型名会被自动忽略并回落）
LLM_MODEL=qwen-plus
# 通用密钥 / 地址：供应商专属配置优先（见下方 DASHSCOPE_* / DEEPSEEK_* / OPENAI_*）
# 注意：LLM_API_KEY / LLM_BASE_URL 只对「当前 LLM_PROVIDER」生效，
#       其他供应商的默认地址或密钥不会被误用；跨供应商（如向量用 qwen）请配置专属变量
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# 按用途覆盖模型，支持 k=v 逗号分隔或 JSON；供应商限定键写作 deepseek.chat
# 示例：LLM_MODEL_MAP=chat=deepseek-chat,talent=deepseek-reasoner
LLM_MODEL_MAP=
# 追加模型降级链，多个备选用 / 分隔；示例：deepseek-reasoner=deepseek-chat
LLM_FALLBACK_MODELS=
# 向量模型供应商标识与模型（DeepSeek 不提供 embedding，需指向 qwen / openai）
LLM_EMBED_PROVIDER=
LLM_EMBED_MODEL=

# 通义千问（DashScope）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=

# DeepSeek（OpenAI 兼容协议）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# 留空使用供应商默认模型（deepseek-chat）；也可指定 deepseek-reasoner 等任意模型
DEEPSEEK_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Ollama 本地模型（无需密钥）
OLLAMA_BASE_URL=
OLLAMA_MODEL=

DIFY_BASE_URL=http://127.0.0.1/v1
DIFY_API_KEY=
