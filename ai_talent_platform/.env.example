# ============================================================
# 标签：[架构组] [P1]（环境变量模板：只放占位符，禁止写入真实密钥）
# AI 数字化人才平台 —— 环境变量模板
# 使用方式：cp .env.example .env 后按本地环境修改
# 注意：.env 不要提交到 Git（已在 .gitignore 中忽略）
# ============================================================

# ------------------------------------------------------------ 应用
APP_NAME=AI 数字化人才平台
APP_VERSION=1.0.0
# dev | test | prod
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
# 允许跨域的前端来源，多个用逗号分隔；* 表示放开（仅调试）
# 注意：* 模式下自动关闭 allow_credentials（浏览器拒绝 *+credentials 组合）
CORS_ORIGINS=*
# 启动时 create_all 自动建表：仅 dev/test 生效；prod 恒为 False（走 Alembic）
DB_AUTO_CREATE_TABLES=true

# ------------------------------------------------------------ 限流
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LIMIT=300
RATE_LIMIT_WINDOW_SECONDS=60
# 前端站点地址（邮件里的笔试入口链接指向 {FRONTEND_URL}/exam/{id}），如 https://www.example.com
# 若前端已实现考试页则优先使用；留空则回退到 PUBLIC_BASE_URL（后端内置考试页）
FRONTEND_URL=
# 后端对外的公网访问基址（候选人邮件里打开内置考试页用），如 https://api.example.com
# 生产必填：笔试链接 = {PUBLIC_BASE_URL}/exam/{id}?token=...，留空会导致邮件链接点不开
PUBLIC_BASE_URL=

# ------------------------------------------------------------ MySQL（业务主数据库）
# 平台不使用 SQLite：业务主数据统一使用 MySQL 8（异步驱动 mysql+aiomysql）
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ai_talent_platform
DB_CHARSET=utf8mb4

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
# 是否在控制台打印 SQL（调试用，平时关闭）
DB_ECHO=false

# ------------------------------------------------------------ PgSQL（分析 / 时序数据库）
# 存放海量履历、测评历史、培训轨迹、行为时序与分析宽表，是 Vanna NL2SQL 的查询库
# 关闭后分析类功能自动降级为「仅统计 MySQL 数据」，不影响业务接口
PGSQL_ENABLED=true
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_USER=postgres
PGSQL_PASSWORD=postgres
PGSQL_DB=ai_talent_analytics
PGSQL_SCHEMA=public
PGSQL_POOL_SIZE=5
PGSQL_MAX_OVERFLOW=10
PGSQL_POOL_RECYCLE=1800
PGSQL_ECHO=false

# ------------------------------------------------------------ Redis（缓存 / 会话 / 限流）
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_DEFAULT_TTL=300

# ------------------------------------------------------------ Milvus（向量库）
MILVUS_ENABLED=false
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=

# ------------------------------------------------------------ JWT / 安全
# 生产必须换成 32 位以上的随机字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12

LOGIN_MAX_FAIL_TIMES=5
LOGIN_LOCK_MINUTES=15

# ------------------------------------------------------------ 文件存储
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.txt,.png,.jpg,.jpeg

# ------------------------------------------------------------ 日志
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_ROTATION_MB=20
LOG_BACKUP_COUNT=10

# ------------------------------------------------------------ 分页
DEFAULT_PAGE=1
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200

# ------------------------------------------------------------ AI 能力层
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

DIFY_BASE_URL=http://127.0.0.1/v1
DIFY_API_KEY=

# Matching MVP: separate published Workflow application keys
DIFY_JD_API_KEY=
DIFY_EXPLANATION_API_KEY=

# ------------------------------------------------------------ 存储后端（架构组合并）
# local（本地磁盘，默认）/ minio（自建 MinIO）/ oss（阿里云 OSS）/ s3（通用 S3 兼容）
# 业务代码统一走 get_storage()，切换后端无需改代码
STORAGE_BACKEND=local
# 对外访问基址（CDN / 反向代理），留空则按后端规则生成
STORAGE_PUBLIC_URL=
# 预签名下载地址有效期（秒）
STORAGE_PRESIGN_EXPIRE_SECONDS=3600
STORAGE_TIMEOUT=30

# MinIO（S3 协议，path-style）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-talent
MINIO_REGION=us-east-1
# 公共读 / CDN 域名（可选）
MINIO_PUBLIC_URL=

# 阿里云 OSS（Signature V1）
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_SECURE=true
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_PUBLIC_URL=

# 通用 S3 兼容存储（AWS S3 / 其他网关；用 MinIO 请直接配置 MINIO_*）
S3_ENDPOINT=
S3_SECURE=true
S3_PATH_STYLE=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_PUBLIC_URL=

# ------------------------------------------------------------ LLM 多供应商扩展（架构组合并）
# 按用途覆盖模型："chat=deepseek-chat,talent=deepseek-reasoner"（支持 JSON 对象）
# 示例：LLM_MODEL_MAP=chat=deepseek-chat,talent=deepseek-reasoner
LLM_MODEL_MAP=
# 追加/覆盖模型降级链："deepseek-reasoner:deepseek-chat"
LLM_FALLBACK_MODELS=
# 向量模型供应商（默认与 LLM_PROVIDER 相同；供应商无 embedding 能力时必须指定）
LLM_EMBED_PROVIDER=

# 各供应商专属配置（专属配置 > LLM_API_KEY / LLM_BASE_URL / LLM_MODEL > 内置默认）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=

# DeepSeek（OpenAI 兼容协议）
# 注意：模板文件不得写入真实密钥（曾有一版把 sk- 明文提交到仓库，需立即吊销）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# 留空使用供应商默认模型（deepseek-chat）；也可指定 deepseek-reasoner 等任意模型
DEEPSEEK_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Ollama 本地模型（无需密钥）
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL=

# ------------------------------------------------------------ Vanna 问数 MVP（架构组合并）
NL2SQL_MAX_ROWS=1000
NL2SQL_TIMEOUT_SECONDS=30
NL2SQL_ALLOWED_SCHEMA=public
# 分析专用只读账号（不能使用初始化建表账号）
NL2SQL_PGSQL_USER=
NL2SQL_PGSQL_PASSWORD=
# 留空使用项目 data/vanna/chroma 默认目录
VANNA_MEMORY_PATH=

# RAG 向量参数；SiliconFlow 使用 OpenAI 兼容适配器
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_API_KEY=填写你自己的密钥
# LLM_EMBED_PROVIDER=openai
# LLM_EMBED_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# 既有知识向量集合（固定 Schema）
MILVUS_COLLECTION_KNOWLEDGE=knowledge_chunks

# MinIO 持久化补偿，无新增数据库表；启用前确保允许读写专用前缀
RAG_DURABLE_INGEST_ENABLED=false

# 简历自动入库补扫：上传后的后台解析是进程内任务，进程重启会丢失；开启后由恢复 worker
# 周期补处理「原件已提交但还没入库成功」的简历版本（幂等，已成功的不会重复解析）
RESUME_INGEST_SWEEP_ENABLED=true

# 未配置向量供应商时是否允许发布为「仅词法检索」版本（true=可发布但语义召回为空，配置密钥后重建索引补齐）
RAG_ALLOW_PUBLISH_WITHOUT_EMBEDDING=true

# 本地 OCR 与解析资源上限
OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.5
OCR_MAX_PIXELS=20000000
OCR_PDF_SCALE=2
DOCUMENT_MAX_PAGES=200

# recursive 保留原重叠分块；semantic 额外调用句向量模型
CHUNK_STRATEGY=semantic
SEMANTIC_SPLIT_THRESHOLD=0.65

# SiliconFlow模型重排；凭证留空时复用OPENAI_API_KEY
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_TIMEOUT=30

# 独立题库向量集合，不复用知识文档集合
MILVUS_COLLECTION_QUESTIONS=question_bank_vectors

# 分析库同步（MySQL -> PgSQL，见 scripts/sync_analytics.py 与 app/infrastructure/scheduler.py）
ANALYTICS_SYNC_ENABLED=false
ANALYTICS_SYNC_CRON_HOUR=2
ANALYTICS_SYNC_CRON_MINUTE=0
ANALYTICS_SYNC_LOCK_TTL=1800
ANALYTICS_SYNC_RETRY=3

# ------------------------------------------------------------ 合并后补记（默认值即可跑通）
# 以下配置项由各组在合并前后新增，settings 里已有默认值；列在这里是为了避免
# 「代码读一个键、运维不知道」的隐性差异。不填就使用括号内默认值。

# 文档/接口路径（/docs、/openapi.json、/redoc）；生产可关闭 docs
# DOCS_URL=/docs
# OPENAPI_URL=/openapi.json
# REDOC_URL=/redoc

# 分块参数（500 / 100），与 CHUNK_STRATEGY=semantic 配合使用
# CHUNK_SIZE=500
# CHUNK_OVERLAP=100

# Agent 编排（最多 8 步；路由是否先过模型判断，默认 false 走规则路由）
# AGENT_MAX_STEPS=8
# AGENT_ROUTE_LLM=false
# 短期记忆回放轮数（10）
# CONVERSATION_WINDOW=10

# Dify 对话应用 ID，留空则只用工作流
# DIFY_APP_ID_CHAT=

# Embedding 模型名（BAAI/bge-large-zh-v1.5），与 EMBEDDING_DIM 必须匹配
# EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
# SiliconFlow 直连凭证；留空时复用 OPENAI_API_KEY / OPENAI_BASE_URL
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_API_KEY=

# 注意区分两个「人才」集合，Schema 完全不同，不要配成同一个名字：
#   MILVUS_COLLECTION_TALENT —— 知识库「人才类文档」片段（chunk_id/file_id/category/content/…）
#   TALENT_COLLECTION        —— 人才档案语义索引（chunk_id/embedding/metadata JSON，见 talent_config）
# MILVUS_COLLECTION_TALENT=talent_chunks
# MILVUS_COLLECTION_ASSESSMENT=assessment_chunks
# MILVUS_ANALYZER_TYPE=chinese

# BM25 索引预热回调（C 端 webhook），留空不回调
# C_WEBHOOK_BM25_URL=
# C_WEBHOOK_BM25_TOKEN=

# ------------------------------------------------------------ AI 数字人面试 [Agent组]
# 候选人面试链接前缀：候选优先级 INVITE_BASE_URL > FRONTEND_URL > PUBLIC_BASE_URL > 请求 Host。
# 生产环境请显式配置，否则链接可能指向内网地址。
# INVITE_BASE_URL=https://hr.example.com
# 默认问题数（3-10）、默认时长与链接有效期
# AI_INTERVIEW_DEFAULT_QUESTION_COUNT=6
# AI_INTERVIEW_MAX_QUESTION_COUNT=10
# AI_INTERVIEW_DEFAULT_DURATION_MINUTES=30
# AI_INTERVIEW_LINK_TTL_HOURS=72
# 是否用大模型做问题个性化 / 评语润色（分数始终由规则引擎计算；模型不可用时自动降级）
# AI_INTERVIEW_LLM_PLAN=true
# AI_INTERVIEW_LLM_FEEDBACK=true
# 单次模型调用超时（秒）与单题回答最大长度（字符）
# AI_INTERVIEW_LLM_TIMEOUT_SECONDS=45
# AI_INTERVIEW_ANSWER_MAX_CHARS=4000
