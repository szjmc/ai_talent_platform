# ---------------- Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
build/
dist/

# ---------------- 虚拟环境
.venv/
venv/
env/

# ---------------- 环境变量（含密钥，禁止提交）
# 覆盖所有变体与备份：.env、.env.local、.env.bak-*、.env.cluster、.env.prod ...
.env*
# 模板文件是唯一例外，必须纳入版本管理
!.env.example

# ---------------- 运行数据
data/
logs/
storage/
*.db
*.sqlite
*.sqlite3

# ---------------- 测试与缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
.mypy_cache/

# ---------------- 本地调试临时文件（接口测试残留，禁止提交）
# 注意：`_*.py` 会连 `__init__.py` 一起忽略，导致 Python 包在干净克隆里缺包初始化文件
# （历史事故：app/ai/proctoring/__init__.py 未入库，服务启动即 ImportError）。
# 因此下面用否定规则把 __init__.py 显式放行，只忽略真正的本地临时脚本。
_*.json
_*.txt
_*.py
!__init__.py
*_req.json
backend.log
.workbuddy/

# ---------------- 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---------------- 本地备份与嵌套克隆（禁止提交）
.env.bak.*
ai-digital-talent-platform/

# ---------------- 本地沙箱（假数据 / Mock 服务）
# 说明：sandbox/ 仅用于本机模拟联调，数据全部虚构，不连 MySQL、不被 app/ 引用。
#      合代码时无需任何操作：它对 Git 而言不存在，删除只需 rm -rf sandbox/。
sandbox/

# ---------------- AI 助手工作目录
.workbuddy

# ---------------- 测试临时产物（pytest 运行期生成，禁止提交）
# 说明：pytest 的 tmp_path 默认落在仓库内时会产生 .pytest_tmp/，
#       不忽略会让每次跑测试都留下未跟踪目录，污染 git status。
.pytest_tmp/
